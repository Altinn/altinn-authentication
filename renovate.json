{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Altinn/renovate-config",
    "local>Altinn/altinn-authorization-tmp:renovate"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["Testcontainers", "Testcontainers.PostgreSql"],
      "groupName": "Testcontainers for .NET",
      "groupSlug": "testcontainers-for-dotnet",
      "matchUpdateTypes": ["major"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update annotated NuGet tool versions in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[a-z][A-Za-z0-9]*Version:\\s*[\\\"']?(?<currentValue>[^\\s\\\"']+)"
      ]
    }
  ]
}
